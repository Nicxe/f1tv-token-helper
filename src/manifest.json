{
  "manifest_version": 3,
  "name": "F1TV Token Helper",
  "version": "0.1.0",
  "description": "Send your local F1TV live timing token to Home Assistant.",
  "action": {
    "default_title": "F1TV Token Helper",
    "default_popup": "popup.html"
  },
  "permissions": ["cookies", "activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://formula1.com/*", "https://*.formula1.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
